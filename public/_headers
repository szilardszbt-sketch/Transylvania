# Netlify Custom HTTP Headers
# Docs: https://docs.netlify.com/routing/headers/

# HTML Entry Points: Never cache aggressively.
# Always revalidate to avoid stale chunk references during network transitions.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Decap CMS Admin
/admin/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed Vite assets (JS, CSS, SVGs, chunked files)
# Content-hashed files are safe for 1-year immutable caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Uploaded images and media
/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
