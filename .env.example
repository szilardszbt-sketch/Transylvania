# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# ADMIN AUTHENTICATION & SECURITY
# =========================================================================
# Admin username for moderation login
ADMIN_USERNAME="admin"

# Bcrypt hash of the admin password. Never commit plain-text passwords.
# Example generated with bcrypt (cost factor 10):
ADMIN_PASSWORD_HASH=""

# Optional plaintext password fallback (for development only; bcrypt hash takes precedence)
ADMIN_PASSWORD=""

# Secret key for signing and verifying JWT session tokens
JWT_SECRET=""

# Administrator email address where new location submission notifications are dispatched
ADMIN_EMAIL="info@transylvaniaatlas.com"

# =========================================================================
# EMAIL DELIVERY (Nodemailer / SMTP or Resend)
# =========================================================================
# SMTP server host (e.g., smtp.resend.com, smtp.sendgrid.net, smtp.gmail.com)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Transylvania Guide <notifications@transylvania-guide.ro>"

# Or direct Resend API Key:
RESEND_API_KEY=""

# =========================================================================
# HEADLESS WORDPRESS REST API INTEGRATION
# =========================================================================
# Base URL for WordPress site (e.g. https://journal.transylvania-guide.ro or https://my-blog.com)
# When configured, blog posts and location-matched articles are fetched via /wp-json/wp/v2/
WORDPRESS_API_URL=""
VITE_WORDPRESS_API_URL=""

# =========================================================================
# DURABLE PHOTO STORAGE (Cloudinary / S3)
# =========================================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

